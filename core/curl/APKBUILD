pkgname=curl
pkgver=8.23.0
pkgrel=0
pkgdesc="command line tool and library for transferring data with URLs"
url="https://curl.se"
arch="all"
license="MIT"
depends="libcurl libssl3 nghttp2 zlib-ng zstd brotli libpsl qnx-io-sock"
depends_dev="openssl-dev nghttp2-dev zlib-ng-dev zstd-dev brotli-dev libidn2-dev libpsl-dev qnx-io-sock-dev"
makedepends="$depends_dev perl nproc"
checkdepends="python3"
subpackages="$pkgname-static $pkgname-doc $pkgname-dev libcurl"
source="https://curl.se/download/curl-$pkgver.tar.xz"

build() {
    ./configure \
        --build="$CBUILD" \
        --host="$CHOST" \
        --prefix=/usr \
        --enable-manual \
        --enable-static \
        --enable-ipv6 \
        --enable-threaded-resolver \
        --enable-websockets \
        --with-openssl \
        --with-libpsl \
        --disable-ldap \
        --disable-ldaps \
        --with-ca-bundle='/etc/ssl/certs/ca-certificates.crt' \
        --with-ca-fallback
   make
}

check() {
    cd tests

    make
    # Test 762 sets date to 1940 and it's failing for some reason. TODO: investigate
    # Test 2072 Unix path thing, we do it weirdly so probably slightly broken. TODO: investigate
    # Tests 1140,1173 are flaky on builders, it is for manpages. TODO: investigate
    LD_LIBRARY_PATH="$builddir/lib/.libs:$LD_LIBRARY_PATH" ./runtests.pl -j$(nproc) !762 !2072 !1140 !1173
    #./runtests.pl | START_DIR=$startdir $startdir/parse_tests.py
}

package() {
    # depends on exactly the same build of libcurl
    depends="libcurl=$pkgver-r$pkgrel"

    make DESTDIR="$pkgdir" install
}

libcurl() {
    pkgdesc="The multiprotocol file transfer library"
    amove usr/lib
}

dev() {
    default_dev
    # Used by trurl
    install -Dm755 -t "$subpkgdir"/usr/bin "$builddir"/scripts/cd2nroff
}

